# Required: Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Required: Supabase anonymous/public key
SUPABASE_ANON_KEY=your-anon-key

# Optional: PortOne merchant code (defaults to imp00000000)
PORTONE_IMP_CODE=imp00000000

# Optional: Sentry DSN. Leave empty to disable crash reporting (debug builds
# and dev environments). CrashReporter.init() short-circuits on empty.
SENTRY_DSN=
