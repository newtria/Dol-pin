# Required: Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Required: Supabase anonymous/public key
SUPABASE_ANON_KEY=your-anon-key

# Server/operator secrets. Keep these out of every client bundle.
# Client public config belongs in apps/mobile/.env.local and apps/web/.env.local.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORTONE_IMP_KEY=your-portone-rest-api-key
PORTONE_IMP_SECRET=your-portone-rest-api-secret
DOLPIN_ADMIN_ACTION_KEY=change-me-to-a-32-plus-character-random-secret
GEMINI_API_KEY=your-gemini-api-key
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT_JSON=base64-or-raw-service-account-json

# RN / Next.js clients: copy apps/mobile/.env.example and apps/web/.env.example
# to the respective .env.local. Edge secrets: supabase/functions/.env.example.
TOSS_SECRET_KEY=test_sk_replace_me
DOLPIN_WEB_URL=http://127.0.0.1:3000
# OAuth provider values go into Supabase Auth > Providers (not client bundles).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
# Kakao REST API key + Login client secret
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Naver OIDC credentials, registered by scripts/configure-naver.mjs
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Supported image-analysis model; override without changing application code.
GEMINI_MODEL=gemini-3.6-flash

# Dedicated service-delivery bearer, also provisioned into Supabase Vault.
SERVICE_DELIVERY_TOKEN=change-me-to-a-32-plus-character-random-secret
OPS_ALERT_WEBHOOK_URL=
EXPO_ACCESS_TOKEN=

# Hosted deployment: distinct GitHub staging/production environments supply
# these values. CLI deployment never pushes the local Auth/SMS fixture config.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
DOLPIN_STAGING_PROJECT_REF=
DOLPIN_PRODUCTION_PROJECT_REF=
DOLPIN_DEPLOY_ENVIRONMENT=

# Separate monitoring environment. Enable scheduled checks through the GitHub
# repository variable DOLPIN_MONITOR_ENABLED=true after configuring these.
DOLPIN_OPS_URL=
DOLPIN_OPS_SERVICE_KEY=
DOLPIN_WATCHDOG_WEBHOOK_URL=
