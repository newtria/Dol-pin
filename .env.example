# Required: Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Required: Supabase anonymous/public key
SUPABASE_ANON_KEY=your-anon-key

# Required for release Flutter builds
PORTONE_IMP_CODE=imp00000000
SENTRY_DSN=

# Required for Supabase Edge Functions / release preflight.
# Do not expose these in the Flutter app.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PORTONE_IMP_KEY=your-portone-rest-api-key
PORTONE_IMP_SECRET=your-portone-rest-api-secret
DOLPIN_ADMIN_ACTION_KEY=change-me-to-a-32-plus-character-random-secret
GEMINI_API_KEY=your-gemini-api-key
FCM_PROJECT_ID=your-firebase-project-id
FCM_SERVICE_ACCOUNT_JSON=base64-or-raw-service-account-json

# New RN / Next.js clients: copy apps/mobile/.env.example and apps/web/.env.example
# to the respective .env.local. Edge secrets: supabase/functions/.env.example.
TOSS_SECRET_KEY=test_sk_replace_me
DOLPIN_WEB_URL=http://127.0.0.1:3000
# OAuth provider values go into Supabase Auth > Providers (not client bundles).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
