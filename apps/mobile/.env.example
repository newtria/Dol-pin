EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Google/Apple secrets live in Supabase Auth, never in EXPO_PUBLIC variables.
# Checkout URL is supplied by the authenticated Edge Function.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_EAS_PROJECT_ID=
DOLPIN_IOS_BUNDLE_IDENTIFIER=
DOLPIN_ANDROID_PACKAGE=
# Local path supplied by the release environment; do not commit its contents.
DOLPIN_GOOGLE_SERVICES_FILE=
