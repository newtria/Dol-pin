# Platform supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
TOSS_SECRET_KEY=test_sk_replace_me
# Deployed web origin. iOS Simulator can use http://127.0.0.1:3000;
# physical devices require a reachable HTTPS web deployment.
DOLPIN_WEB_URL=http://127.0.0.1:3000

GEMINI_API_KEY=your-gemini-api-key

# Supported image-analysis model; override without changing application code.
GEMINI_MODEL=gemini-3.6-flash
